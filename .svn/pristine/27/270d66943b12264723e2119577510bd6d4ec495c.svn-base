    QVBoxLayout *layoutGauche = new QVBoxLayout(colonneGauche);
    layoutGauche->setContentsMargins(0, 0, 0, 0);
    layoutGauche->setSpacing(10);

    // Onglets SSS / SRS / SDD
    ongletsFichiers = new QTabWidget();
    ongletsFichiers->setStyleSheet(R"(
        QTabWidget::pane {
            border: 1px solid #DDDDDD;
            border-radius: 8px;
            background-color: #FFFFFF;
            padding: 10px;
        }
        QTabBar::tab {
            background: #EBF5FB;
            color: #555555;
            padding: 6px 16px;
            border-radius: 4px;
            margin-right: 3px;
            border: 1px solid #DDDDDD;
            font-size: 11px;
            font-weight: bold;
        }
        QTabBar::tab:selected { background: #2E86C1; color: white; border: none; }
    )");

    // ── Tab SSS ──
    QWidget *tabSSS = new QWidget();
    QVBoxLayout *lSSS = new QVBoxLayout(tabSSS);
    champSSS = new QLineEdit();
    champSSS->setPlaceholderText("Aucun fichier...");
    champSSS->setReadOnly(true);
    btnParcourirSSS = new QPushButton("📁  Parcourir");
    badgeSSS = new QLabel("");
    badgeSSS->setAlignment(Qt::AlignCenter);
    badgeSSS->setTextFormat(Qt::RichText);
    erreurSSS = new QLabel("");
    erreurSSS->setStyleSheet("color: #E74C3C; font-size: 9px;");
    erreurSSS->setWordWrap(true);
    listeSSS = new QListWidget();
    listeSSS->setFixedHeight(70);
    listeSSS->setStyleSheet(R"(
        QListWidget {
            background-color: #F8F9FA;
            border: 1px solid #DDDDDD;
            border-radius: 4px;
            font-size: 9px;
        }
        QListWidget::item { padding: 2px 6px; }
    )");
    lSSS->addWidget(champSSS);
    lSSS->addWidget(btnParcourirSSS);
    lSSS->addWidget(badgeSSS);
    lSSS->addWidget(erreurSSS);
    lSSS->addWidget(listeSSS);
    lSSS->addStretch();

    // ── Tab SRS ──
    QWidget *tabSRS = new QWidget();
    QVBoxLayout *lSRS = new QVBoxLayout(tabSRS);
    champSRS = new QLineEdit();
    champSRS->setPlaceholderText("Aucun fichier...");
    champSRS->setReadOnly(true);
    btnParcourirSRS = new QPushButton("📁  Parcourir");
    badgeSRS = new QLabel("");
    badgeSRS->setAlignment(Qt::AlignCenter);
    badgeSRS->setTextFormat(Qt::RichText);
    erreurSRS = new QLabel("");
    erreurSRS->setStyleSheet("color: #E74C3C; font-size: 9px;");
    erreurSRS->setWordWrap(true);
    listeSRS = new QListWidget();
    listeSRS->setFixedHeight(70);
    listeSRS->setStyleSheet(R"(
        QListWidget {
            background-color: #F8F9FA;
            border: 1px solid #DDDDDD;
            border-radius: 4px;
            font-size: 9px;
        }
        QListWidget::item { padding: 2px 6px; }
    )");
    lSRS->addWidget(champSRS);
    lSRS->addWidget(btnParcourirSRS);
    lSRS->addWidget(badgeSRS);
    lSRS->addWidget(erreurSRS);
    lSRS->addWidget(listeSRS);
    lSRS->addStretch();

    // ── Tab SDD ──
    QWidget *tabSDD = new QWidget();
    QVBoxLayout *lSDD = new QVBoxLayout(tabSDD);
    champSDD = new QLineEdit();
    champSDD->setPlaceholderText("Aucun fichier...");
    champSDD->setReadOnly(true);
    btnParcourirSDD = new QPushButton("📁  Parcourir");
    badgeSDD = new QLabel("");
    badgeSDD->setAlignment(Qt::AlignCenter);
    badgeSDD->setTextFormat(Qt::RichText);
    erreurSDD = new QLabel("");
    erreurSDD->setStyleSheet("color: #E74C3C; font-size: 9px;");
    erreurSDD->setWordWrap(true);
    listeSDD = new QListWidget();
    listeSDD->setFixedHeight(70);
    listeSDD->setStyleSheet(R"(
        QListWidget {
            background-color: #F8F9FA;
            border: 1px solid #DDDDDD;
